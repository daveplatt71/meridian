# Maintainer: Dave Platt <https://github.com/daveplatt71>
pkgname=omaridian
pkgver=0.1.0
pkgrel=3
pkgdesc='Offline vintage world-clock screensaver for Omarchy and Wayland'
arch=('x86_64')
url='https://github.com/daveplatt71/meridian'
license=('MIT')
depends=('qt6-base>=6.11' 'qt6-declarative>=6.11' 'qt6-wayland>=6.11' 'wayland' 'noto-fonts')
makedepends=('cmake' 'ninja')
source=("omaridian-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('5749c1e9e4444fc556bfbd33f9653b8af1bd0ecde816c320b86803b979954706')

build() {
    cmake -S "$srcdir/meridian-$pkgver" -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DOMARIDIAN_WITH_LAYER_SHELL=OFF
    cmake --build "$srcdir/build"
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
    local source_dir="$srcdir/meridian-$pkgver"
    install -Dm755 "$srcdir/build/omaridian" "$pkgdir/usr/bin/omaridian"
    install -Dm755 "$source_dir/integration/omarchy/omarchy-launch-screensaver" \
        "$pkgdir/usr/share/omaridian/omarchy/omarchy-launch-screensaver"
    install -Dm755 "$source_dir/integration/omarchy/install.sh" \
        "$pkgdir/usr/share/omaridian/omarchy/install.sh"
    install -Dm755 "$source_dir/integration/omarchy/uninstall.sh" \
        "$pkgdir/usr/share/omaridian/omarchy/uninstall.sh"
    install -Dm644 "$source_dir/integration/omarchy/omarchy-screensaver.conf.example" \
        "$pkgdir/usr/share/omaridian/omarchy/omarchy-screensaver.conf.example"
    install -Dm644 "$source_dir/integration/omarchy/README.md" \
        "$pkgdir/usr/share/omaridian/omarchy/README.md"
    install -Dm644 "$source_dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$source_dir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$source_dir/assets/README.md" "$pkgdir/usr/share/doc/$pkgname/assets-README.md"
    install -Dm644 "$source_dir/assets/RELIEF.md" "$pkgdir/usr/share/doc/$pkgname/assets-RELIEF.md"
    install -Dm644 "$source_dir/PERFORMANCE.md" "$pkgdir/usr/share/doc/$pkgname/PERFORMANCE.md"
}
