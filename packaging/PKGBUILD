pkgname=omaridian
pkgver=0.1.1
pkgrel=1
pkgdesc='Offline vintage world-clock screensaver for Omarchy and Wayland'
arch=('x86_64')
url='https://github.com/daveplatt71/meridian'
license=('MIT')
depends=('qt6-base>=6.11' 'qt6-declarative>=6.11' 'qt6-wayland>=6.11' 'wayland' 'noto-fonts')
makedepends=('cmake' 'ninja')
source=()
sha256sums=()

build() {
    # Keep makepkg's disposable src/ directory away from the project's
    # tracked src/ directory.
    cmake -S "$startdir/.." -B "$srcdir/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DOMARIDIAN_WITH_LAYER_SHELL=OFF
    cmake --build "$srcdir/build"
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
    install -Dm755 "$srcdir/build/omaridian" "$pkgdir/usr/bin/omaridian"
    install -Dm755 "$startdir/../integration/omarchy/omarchy-launch-screensaver" \
        "$pkgdir/usr/share/omaridian/omarchy/omarchy-launch-screensaver"
    install -Dm755 "$startdir/../integration/omarchy/install.sh" \
        "$pkgdir/usr/share/omaridian/omarchy/install.sh"
    install -Dm755 "$startdir/../integration/omarchy/uninstall.sh" \
        "$pkgdir/usr/share/omaridian/omarchy/uninstall.sh"
    install -Dm644 "$startdir/../integration/omarchy/omarchy-screensaver.conf.example" \
        "$pkgdir/usr/share/omaridian/omarchy/omarchy-screensaver.conf.example"
    install -Dm644 "$startdir/../integration/omarchy/README.md" \
        "$pkgdir/usr/share/omaridian/omarchy/README.md"
    install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$startdir/../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$startdir/../assets/README.md" "$pkgdir/usr/share/doc/$pkgname/assets-README.md"
    install -Dm644 "$startdir/../assets/RELIEF.md" "$pkgdir/usr/share/doc/$pkgname/assets-RELIEF.md"
    install -Dm644 "$startdir/../PERFORMANCE.md" "$pkgdir/usr/share/doc/$pkgname/PERFORMANCE.md"
}
